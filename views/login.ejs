<div class="container">
  <div class="row justify-content-center min-vh-100 align-items-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-lg border-0 rounded-lg fade-in" style="border-radius: 20px;">
        <div class="card-header text-center py-4" style="border-bottom: none; background: var(--primary-gradient); border-radius: 20px 20px 0 0;">
          <h3 class="my-3 text-white" style="font-weight: 700;">
            <i class="fas fa-bell me-2"></i> Firebase Notification Dashboard
          </h3>
          <p class="text-white mb-0" style="opacity: 0.9;">Sign in to manage your notifications</p>
        </div>
        <div class="card-body p-4">
          <form action="/auth/login" method="POST">
            <div class="mb-4">
              <label for="username" class="form-label" style="font-weight: 600;">Username</label>
              <div class="input-group">
                <span class="input-group-text" style="background: var(--primary-gradient); color: white; border: none;">
                  <i class="fas fa-user"></i>
                </span>
                <input type="text" id="username" name="username" class="form-control" placeholder="Enter your username" required autofocus>
              </div>
            </div>
            
            <div class="mb-4">
              <label for="password" class="form-label" style="font-weight: 600;">Password</label>
              <div class="input-group">
                <span class="input-group-text" style="background: var(--primary-gradient); color: white; border: none;">
                  <i class="fas fa-lock"></i>
                </span>
                <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
              </div>
            </div>
            
            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-primary btn-lg" style="padding: 0.85rem;">
                <i class="fas fa-sign-in-alt me-2"></i> Sign In
              </button>
            </div>
          </form>
        </div>
        <div class="card-footer text-center py-4" style="background: transparent; border-top: 1px solid var(--border-color);">
          <div class="small" style="color: var(--text-muted);">
            <i class="fas fa-shield-alt me-1"></i> Secure Notification Management System
          </div>
        </div>
      </div>
      
      <div class="text-center mt-4">
        <div id="theme-toggler" class="theme-toggler mx-auto pulse"></div>
        <div class="mt-3" style="color: var(--text-muted); font-weight: 500;">
          <i class="fas fa-adjust me-1"></i> Toggle Theme
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .min-vh-100 {
    min-height: 100vh !important;
  }
  
  .login-container {
    background: radial-gradient(circle at top right, rgba(102, 126, 234, 0.1), transparent 50%),
                radial-gradient(circle at bottom left, rgba(118, 75, 162, 0.1), transparent 50%);
  }
  
  .input-group:focus-within {
    transform: translateY(-2px);
    transition: all 0.3s ease;
  }
  
  .card {
    backdrop-filter: blur(10px);
  }
</style>
