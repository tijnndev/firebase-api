<div class="container-fluid fade-in">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3" style="font-weight: 700;">
      <i class="fas fa-tachometer-alt me-2" style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"></i> 
      Dashboard Overview
    </h1>
  </div>
  
  <div class="stats-grid">
    <div class="card fade-in" style="animation-delay: 0.1s;">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-xs font-weight-bold text-uppercase mb-2" style="color: var(--text-muted); letter-spacing: 1px;">
              <i class="fas fa-server me-1"></i> Services
            </div>
            <div class="h5 mb-0 font-weight-bold" style="font-size: 2.5rem;"><%= stats.servicesCount %></div>
          </div>
          <div style="width: 60px; height: 60px; background: var(--primary-gradient); border-radius: 12px; display: flex; align-items: center; justify-content: center; opacity: 0.15;">
            <i class="fas fa-server fa-2x"></i>
          </div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-0 d-flex gap-2">
        <a href="/services" class="btn btn-sm btn-primary flex-fill">
          <i class="fas fa-eye me-1"></i> View All
        </a>
        <a href="/services/create" class="btn btn-sm btn-outline-primary flex-fill">
          <i class="fas fa-plus me-1"></i> Add New
        </a>
      </div>
    </div>
    
    <div class="card fade-in" style="animation-delay: 0.2s;">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-xs font-weight-bold text-uppercase mb-2" style="color: var(--text-muted); letter-spacing: 1px;">
              <i class="fas fa-key me-1"></i> FCM Tokens
            </div>
            <div class="h5 mb-0 font-weight-bold" style="font-size: 2.5rem;"><%= stats.tokensCount %></div>
          </div>
          <div style="width: 60px; height: 60px; background: var(--success-gradient); border-radius: 12px; display: flex; align-items: center; justify-content: center; opacity: 0.15;">
            <i class="fas fa-key fa-2x"></i>
          </div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-0">
        <a href="/tokens" class="btn btn-sm btn-success w-100">
          <i class="fas fa-eye me-1"></i> View All Tokens
        </a>
      </div>
    </div>
  </div>
  
  <div class="row">
    <div class="col-lg-8 mb-4">
      <div class="card fade-in" style="animation-delay: 0.3s;">
        <div class="card-header" style="background: var(--primary-gradient); color: white; border-radius: 16px 16px 0 0;">
          <h5 class="mb-0">
            <i class="fas fa-bell me-2"></i> Notification Test Center
          </h5>
        </div>
        <div class="card-body">
          <div class="notification-test-area">
            <%- include('./notification/test') %>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4 mb-4">
      <div class="card fade-in" style="animation-delay: 0.4s;">
        <div class="card-header" style="background: var(--success-gradient); color: white; border-radius: 16px 16px 0 0;">
          <h5 class="mb-0">
            <i class="fas fa-info-circle me-2"></i> Quick Guide
          </h5>
        </div>
        <div class="card-body">
          <div class="mb-4 p-3" style="background: var(--active-link); border-radius: 12px; border-left: 4px solid; border-image: var(--primary-gradient) 1;">
            <h6 style="font-weight: 700;">
              <i class="fas fa-server me-2"></i> Services
            </h6>
            <p class="mb-0 small" style="color: var(--text-muted);">
              Create and manage notification services. Each service has a unique secret key for sending notifications.
            </p>
          </div>
          
          <div class="mb-4 p-3" style="background: var(--active-link); border-radius: 12px; border-left: 4px solid; border-image: var(--success-gradient) 1;">
            <h6 style="font-weight: 700;">
              <i class="fas fa-key me-2"></i> FCM Tokens
            </h6>
            <p class="mb-0 small" style="color: var(--text-muted);">
              View and manage device tokens registered with your services. These tokens are used to send notifications to specific devices.
            </p>
          </div>
          
          <div class="p-3" style="background: var(--active-link); border-radius: 12px; border-left: 4px solid; border-image: var(--warning-gradient) 1;">
            <h6 style="font-weight: 700;">
              <i class="fas fa-bell me-2"></i> Notifications
            </h6>
            <p class="mb-0 small" style="color: var(--text-muted);">
              Test sending notifications to devices registered with your services using the notification test center.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .fade-in {
    animation: fadeIn 0.6s ease forwards;
    opacity: 0;
  }
</style>
